<section class="journal" style="background-color: {{ section.settings.background }};">
  <div class="page-width">
    <div class="section-heading section-heading--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>

    <div class="journal__grid">
      {%- assign blog = section.settings.blog -%}
      {%- if blog != blank -%}
        {%- for article in blog.articles limit: section.settings.articles_to_show -%}
          <article class="journal-card">
            <a href="{{ article.url }}" class="journal-card__image-wrap">
              {%- if article.image != blank -%}
                <img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title | escape }}" loading="lazy" width="700" height="700">
              {%- else -%}
                <div class="journal-card__placeholder"></div>
              {%- endif -%}
              <div class="journal-card__scrim"></div>
            </a>
            <div class="journal-card__text">
              <h3 class="journal-card__title">{{ article.title }}</h3>
              <a href="{{ article.url }}" class="journal-card__link">
                Read Article
                {% render 'icon-arrow-right', color: '#0a0a0a' %}
              </a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="journal-card">
            <div class="journal-card__image-wrap">
              <div class="journal-card__placeholder"></div>
            </div>
            <div class="journal-card__text">
              <h3 class="journal-card__title">Add a blog in section settings</h3>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="journal__button-row">
        <a href="{{ blog.url | default: '#' }}" class="btn btn--primary">
          {{ section.settings.button_label }}
          {% render 'icon-arrow-right', color: 'white' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Journal",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE SORA JOURNAL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ideas for living well." },
    { "type": "color", "id": "background", "label": "Background color", "default": "#f6ecec" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "articles_to_show", "label": "Articles to show", "min": 1, "max": 6, "default": 3 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View more articles" }
  ],
  "presets": [{ "name": "Journal" }]
}
{% endschema %}
