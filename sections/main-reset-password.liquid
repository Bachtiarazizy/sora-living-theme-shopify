<section class="account-page page-width account-page--narrow">
  <h1>Reset your password</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label>New password<input type="password" name="customer[password]" required></label>
    <label>Confirm password<input type="password" name="customer[password_confirmation]" required></label>
    <button type="submit" class="btn btn--primary">Reset Password</button>
  {%- endform -%}
</section>
{% schema %}{ "name": "Reset password", "settings": [] }{% endschema %}
