<section class="newsletter">
  {%- if section.settings.image != blank -%}
    <img class="newsletter__bg" src="{{ section.settings.image | image_url: width: 1600 }}" alt="" loading="lazy" width="1600" height="1200">
  {%- else -%}
    <div class="newsletter__bg newsletter__bg--placeholder"></div>
  {%- endif -%}
  <div class="newsletter__overlay"></div>

  <div class="newsletter__content page-width">
    <div class="newsletter__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--light">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<p class="newsletter__body">{{ section.settings.body }}</p>{%- endif -%}
    </div>

    {%- form 'customer', id: 'NewsletterForm' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter__form-row">
        <input
          type="email"
          name="contact[email]"
          placeholder="Your email address"
          required
          class="newsletter__input"
          value="{% if customer %}{{ customer.email }}{% endif %}"
        >
        <button type="submit" class="btn btn--primary">
          Subscribe
          {% render 'icon-arrow-right', color: 'white' %}
        </button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="newsletter__success">Thanks for subscribing!</p>
      {%- endif -%}
      <label class="newsletter__agreement">
        <input type="checkbox" required>
        <span>By subscribing, you agree to receive emails from {{ shop.name }}.</span>
      </label>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "STAY INSPIRED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bring better living home." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Get new collection launches, design inspiration, and selected offers delivered to your inbox." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
