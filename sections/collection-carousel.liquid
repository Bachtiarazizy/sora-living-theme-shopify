<section class="collection-carousel page-width">
  <div class="section-heading section-heading--center">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
  </div>

  <div class="collection-carousel__track" id="CollectionCarousel-{{ section.id }}">
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      <a href="{% if col != blank %}{{ col.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="collection-card" {{ block.shopify_attributes }}>
        <div class="collection-card__image-wrap">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.label }}" loading="lazy" width="600" height="600">
          {%- elsif col.featured_image != blank -%}
            <img src="{{ col.featured_image | image_url: width: 600 }}" alt="{{ block.settings.label }}" loading="lazy" width="600" height="600">
          {%- else -%}
            <div class="collection-card__placeholder"></div>
          {%- endif -%}
          <div class="collection-card__scrim"></div>
        </div>
        <p class="collection-card__label">{{ block.settings.label }}</p>
      </a>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 4 -%}
    <div class="carousel-nav">
      <button class="carousel-nav__btn" data-carousel-prev="CollectionCarousel-{{ section.id }}" aria-label="Previous">{% render 'icon-arrow-right', color: '#271607' %}</button>
      <button class="carousel-nav__btn" data-carousel-next="CollectionCarousel-{{ section.id }}" aria-label="Next">{% render 'icon-arrow-right', color: '#271607' %}</button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Collection carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CUSTOMER FAVORITES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Curated for every corner." }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "default": "Living Room" },
        { "type": "image_picker", "id": "image", "label": "Custom image (optional)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "collection", "settings": { "label": "Living Room" } },
      { "type": "collection", "settings": { "label": "Dining Room" } },
      { "type": "collection", "settings": { "label": "Bedroom" } },
      { "type": "collection", "settings": { "label": "Outdoor" } }
    ]
  },
  "presets": [{ "name": "Collection carousel" }]
}
{% endschema %}
