<section class="hero" style="--slide-count: {{ section.blocks.size | default: 1 }};">
  <div class="hero__slides" id="HeroSlides-{{ section.id }}">
    {%- for block in section.blocks -%}
      <div class="hero__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img
            class="hero__image"
            src="{{ block.settings.image | image_url: width: 1600 }}"
            srcset="{{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1600 }} 1600w, {{ block.settings.image | image_url: width: 2400 }} 2400w"
            sizes="100vw"
            alt="{{ block.settings.image.alt | escape }}"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          >
        {%- else -%}
          <div class="hero__image hero__image--placeholder"></div>
        {%- endif -%}
        <div class="hero__overlay"></div>

        <div class="hero__content">
          <div class="hero__header">
            <div class="hero__text">
              <h1 class="hero__heading">{{ block.settings.heading }}</h1>
              {%- if block.settings.subheading != blank -%}
                <p class="hero__subheading">{{ block.settings.subheading }}</p>
              {%- endif -%}
            </div>
            <div class="hero__buttons">
              {%- if block.settings.primary_label != blank -%}
                <a href="{{ block.settings.primary_link }}" class="btn btn--primary">
                  {{ block.settings.primary_label }}
                  {% render 'icon-arrow-right', color: 'white' %}
                </a>
              {%- endif -%}
              {%- if block.settings.secondary_label != blank -%}
                <a href="{{ block.settings.secondary_link }}" class="btn btn--outline">{{ block.settings.secondary_label }}</a>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}

    {%- if section.blocks.size == 0 -%}
      <div class="hero__slide is-active">
        <div class="hero__image hero__image--placeholder"></div>
        <div class="hero__overlay"></div>
        <div class="hero__content">
          <div class="hero__header">
            <div class="hero__text">
              <h1 class="hero__heading">Furniture made for better living.</h1>
              <p class="hero__subheading">Thoughtfully designed pieces crafted with natural materials, timeless forms, and everyday comfort in mind.</p>
            </div>
            <div class="hero__buttons">
              <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Shop Furniture {% render 'icon-arrow-right', color: 'white' %}</a>
              <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">Explore Collection</a>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero__dots" role="tablist">
      {%- for block in section.blocks -%}
        <button class="hero__dot{% if forloop.first %} is-active{% endif %}" data-hero-dot="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Furniture made for better living."
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading",
          "default": "Thoughtfully designed pieces crafted with natural materials, timeless forms, and everyday comfort in mind."
        },
        {
          "type": "text",
          "id": "primary_label",
          "label": "Primary button label",
          "default": "Shop Furniture"
        },
        {
          "type": "url",
          "id": "primary_link",
          "label": "Primary button link"
        },
        {
          "type": "text",
          "id": "secondary_label",
          "label": "Secondary button label",
          "default": "Explore Collection"
        },
        {
          "type": "url",
          "id": "secondary_link",
          "label": "Secondary button link"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "slide"
      },
      {
        "type": "slide"
      },
      {
        "type": "slide"
      }
    ]
  }
}
{% endschema %}
