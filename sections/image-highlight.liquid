<section class="highlight page-width">
  <div class="section-heading section-heading--split">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn btn--primary">
        {{ section.settings.button_label }}
        {% render 'icon-arrow-right', color: 'white' %}
      </a>
    {%- endif -%}
  </div>

  <div class="highlight__image-wrap">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="" loading="lazy" width="1600" height="900">
    {%- else -%}
      <div class="highlight__placeholder"></div>
    {%- endif -%}

    <div class="highlight__features">
      {%- for block in section.blocks -%}
        <div class="highlight__feature" {{ block.shopify_attributes }}>
          <p class="highlight__feature-title">{{ block.settings.title }}</p>
          <p class="highlight__feature-body">{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image highlight",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE SORA LIVING APPROACH" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Beautiful furniture starts with better choices." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover Our Craft" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Natural Materials" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Materials selected for their character, texture, and durability." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "feature", "settings": { "title": "Natural Materials", "body": "Materials selected for their character, texture, and durability." } },
      { "type": "feature", "settings": { "title": "Considered Design", "body": "Simple forms designed to work beautifully across different spaces." } },
      { "type": "feature", "settings": { "title": "Made for Living", "body": "Comfortable, functional pieces created for everyday use." } }
    ]
  },
  "presets": [{ "name": "Image highlight" }]
}
{% endschema %}
