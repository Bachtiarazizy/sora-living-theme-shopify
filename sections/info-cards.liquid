<section class="info-cards">
  <div class="info-cards__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="info-cards__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="info-cards__grid">
      {%- for block in section.blocks -%}
        <div
          class="info-card{% if block.settings.image == blank %} info-card--solid{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <img class="info-card__bg" src="{{ block.settings.image | image_url: width: 600 }}" alt="" loading="lazy" width="600" height="600">
            <div class="info-card__scrim"></div>
          {%- endif -%}

          <div class="info-card__icon">{{ block.settings.icon_svg }}</div>

          <div class="info-card__text">
            <p class="info-card__title">{{ block.settings.title }}</p>
            <p class="info-card__body">{{ block.settings.body }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Info cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed with intention. Made to last."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image (optional)"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon (SVG code)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Thoughtful Design"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body text",
          "default": "Timeless forms designed to complement modern spaces."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "card",
        "settings": {
          "title": "Thoughtful Design",
          "body": "Timeless forms designed to complement modern spaces."
        }
      },
      {
        "type": "card",
        "settings": {
          "title": "Quality Materials",
          "body": "Carefully selected materials chosen for everyday use."
        }
      },
      {
        "type": "card",
        "settings": {
          "title": "Everyday Comfort",
          "body": "Furniture designed around how you actually live."
        }
      },
      {
        "type": "card",
        "settings": {
          "title": "Dedicated Support",
          "body": "We're here to help before and after your purchase."
        }
      }
    ]
  }
}
{% endschema %}
