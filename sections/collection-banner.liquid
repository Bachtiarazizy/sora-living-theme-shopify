<section class="collection-banner page-width{% if section.settings.image_position == 'right' %} collection-banner--reverse{% endif %}">
  <div class="collection-banner__image-wrap">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="" loading="lazy" width="1200" height="1200">
    {%- else -%}
      <div class="collection-banner__placeholder"></div>
    {%- endif -%}
  </div>

  <div class="collection-banner__content">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.body != blank -%}<p class="collection-banner__body">{{ section.settings.body }}</p>{%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn btn--primary">
        {{ section.settings.button_label }}
        {% render 'icon-arrow-right', color: 'white' %}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection banner",
  "settings": [
    { "type": "select", "id": "image_position", "label": "Image position", "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ], "default": "left" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MATERIALS MATTER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for long summer days." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Bring the feeling of open-air living home with furniture designed for slow lunches, warm evenings, and everything in between." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Summer Collection" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Collection banner" }]
}
{% endschema %}
