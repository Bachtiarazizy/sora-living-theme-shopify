<section class="favorites" style="background-color: {{ section.settings.background }};">
  <div class="page-width">
    <div class="section-heading section-heading--split">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary">
          {{ section.settings.button_label }}
          {% render 'icon-arrow-right', color: 'white' %}
        </a>
      {%- endif -%}
    </div>

    <div class="favorites__grid">
      {%- assign source_collection = section.settings.collection -%}
      {%- if source_collection != blank -%}
        {%- for product in source_collection.products limit: section.settings.products_to_show -%}
          {% render 'favorite-product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          {% render 'favorite-product-card', product: blank %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Favorite products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CUSTOMER FAVORITES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pieces people love to live with." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Best Sellers" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Background color", "default": "#f6ecec" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 1, "max": 6, "default": 3 }
  ],
  "presets": [{ "name": "Favorite products" }]
}
{% endschema %}
