<section class="collection-list-page page-width">
  <h1 class="section-heading section-heading--center">Collections</h1>
  <div class="collection-carousel__track collection-carousel__track--wrap">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="collection-card">
        <div class="collection-card__image-wrap">
          {%- if collection.featured_image != blank -%}
            <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title }}" loading="lazy" width="600" height="600">
          {%- else -%}
            <div class="collection-card__placeholder"></div>
          {%- endif -%}
          <div class="collection-card__scrim"></div>
        </div>
        <p class="collection-card__label">{{ collection.title }}</p>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "List collections", "settings": [] }
{% endschema %}
